# Local development: OAuth may stay empty and the app uses a non-admin dev user.
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/cognitive_training
JWT_SECRET=replace-with-a-long-random-secret
DEV_ADMIN=false

# Production/authenticated mode: set these in the deployment secret store.
VITE_APP_ID=your-app-id
OAUTH_SERVER_URL=https://your-oauth-server.example.com
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.example.com
OWNER_OPEN_ID=your-owner-open-id
